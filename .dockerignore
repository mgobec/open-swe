# .dockerignore for Open-SWE
# Excludes unnecessary files and directories from Docker build context
# to optimize build performance and security

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache

# Git repository
.git/
.gitignore
.gitattributes

# Environment files (security)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example

# Build artifacts
.turbo/
**/dist/
**/.next/
.next/cache/
/out/
/build/
*.tsbuildinfo

# Testing
/coverage/
**/__tests__/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js
jest.config.js
**/jest.config.js

# Development files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
lib-cov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next/
out/

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out
storybook-static

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# LangGraph specific
.langgraph_api/
credentials.json

# Documentation build
**/node_modules
docs/.vitepress/dist
docs/.vitepress/cache

# Evaluation and benchmark files
**/evals/
**/langbench/
**/*.eval.ts

# Local development files
**/.claude/
**/.claude/settings.local.json

# Vercel
.vercel

# Turbo
.turbo

# Miscellaneous
*.pem
*.log
*.lock
!yarn.lock
!package-lock.json

# Docker files (avoid recursive Docker builds)
Dockerfile*
.dockerignore
docker-compose*.yml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# README and documentation (optional - uncomment if you want to exclude)
# README.md
# CHANGELOG.md
# LICENSE
# *.md
